DATABASE_URL="file:./dev.db"

# Optional: when configured, POST /api/events requires Authorization: Bearer <key>.
RELAYOPS_API_KEY="replace-with-a-long-random-producer-key"

# Optional: when configured, POST /api/worker/run requires Authorization: Bearer <token>.
RELAYOPS_ADMIN_TOKEN="replace-with-a-long-random-operator-token"

# Optional: the included demo receiver verifies signatures against this same secret.
RELAYOPS_DEMO_SECRET="use-the-same-value-as-your-destination-signing-secret"
